# Kopiere die benötigten Werte in die lokale Datei `.env`.
# Niemals echte Tokens oder Secrets in diese Beispieldatei eintragen.

# Bot-Token aus dem privaten Chat mit dem offiziellen Telegram-Bot @BotFather.
TELEGRAM_BOT_TOKEN=

# Öffentlicher Telegram-Benutzername des Bots, ohne führendes @.
# Beispiel: RaccoonAgentBot
TELEGRAM_BOT_USERNAME=

# Project ID aus https://dashboard.reown.com für WalletConnect/AppKit.
# Öffentliche Anwendungskennung, kein Wallet-Private-Key.
REOWN_PROJECT_ID=

# Eigenständiges Supabase-Projekt für persistente Agent-Daten.
# SUPABASE_SECRET_KEY ist ausschließlich serverseitig zu verwenden.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Zufälliges Geheimnis für die spätere Absicherung des Telegram-Webhooks.
# Für den lokalen Long-Polling-Test noch nicht erforderlich.
TELEGRAM_WEBHOOK_SECRET=

# Eigenes, zufälliges Geheimnis (mindestens 32 Bytes) für Dashboard-Sessions,
# Login-Challenges und pseudonymisierte Rate-Limit-Schlüssel.
DASHBOARD_SESSION_SECRET=

# Schützt den täglichen Vercel-Job für Ablaufwarnungen.
CRON_SECRET=

# Öffentliche Basis-URL der späteren Raccoon-Agent-Anwendung.
# Lokal vorerst nicht erforderlich.
APP_BASE_URL=

# Covers einer Wallet kommen live von der Kette (Alchemy-NFT-Index + Nexus CoverViewer).
# Ohne Schluessel meldet der Agent "Cover-Daten nicht verfuegbar", nie eine leere Liste.
ALCHEMY_API_KEY=

# Produktfakten fuer Bot-Antworten kommen ohne Schluessel von api.nexusmutual.io.

# Optional: Wallet-Adresse, für die ein eindeutig gekennzeichnetes Demo-Cover angezeigt wird.
# Keine echte Nutzer-Wallet in ein öffentliches Repository committen.
DEMO_WALLET=

# Wie oft verknüpfte Wallets auf bald ablaufende Covers geprüft werden (Minimum: 5 Minuten).
ALERT_CHECK_INTERVAL_MINUTES=60

# Optional: freie Telegram-Sprache über die OpenAI Responses API klassifizieren.
# Der Agent sendet Nachrichtentext, Sprache und öffentliches geprüftes Produktwissen,
# niemals Wallet-Adresse, persönliche Cover-Daten oder Telegram-Chat-ID.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-luna
