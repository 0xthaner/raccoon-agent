{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "CRSF pinned sources",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"crsf_version",
		"sources",
		"deferred_sources",
		"change_record",
		"vendored"
	],
	"properties": {
		"crsf_version": {
			"type": "string",
			"pattern": "^1\\.0-draft-[a-z0-9]+$"
		},
		"sources": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"id",
					"org",
					"title",
					"version",
					"date",
					"url",
					"pin"
				],
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^SRC-[A-Z0-9-]+$"
					},
					"org": {
						"type": "string",
						"minLength": 1
					},
					"title": {
						"type": "string",
						"minLength": 1
					},
					"version": {
						"type": "string",
						"minLength": 1
					},
					"date": {
						"type": "string",
						"minLength": 1
					},
					"url": {
						"type": "string",
						"pattern": "^https://"
					},
					"pin": {
						"type": "string",
						"minLength": 1
					},
					"note": {
						"type": [
							"string",
							"null"
						]
					}
				}
			},
			"minItems": 1
		},
		"deferred_sources": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"id",
					"reason"
				],
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"reason": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"minItems": 0
		},
		"change_record": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"crsf_version",
					"change",
					"id",
					"reason"
				],
				"properties": {
					"crsf_version": {
						"type": "string",
						"minLength": 1
					},
					"change": {
						"type": "string",
						"minLength": 1
					},
					"id": {
						"type": "string",
						"minLength": 1
					},
					"reason": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"minItems": 0
		},
		"vendored": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"source",
					"path",
					"sha256",
					"license"
				],
				"properties": {
					"source": {
						"type": "string",
						"minLength": 1
					},
					"path": {
						"type": "string",
						"minLength": 1
					},
					"sha256": {
						"type": "string",
						"pattern": "^[0-9a-f]{64}$"
					},
					"license": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"minItems": 0
		}
	}
}
