{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "CRSF framework change record",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"versions"
	],
	"properties": {
		"versions": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"crsf_version",
					"summary",
					"changes"
				],
				"properties": {
					"crsf_version": {
						"type": "string",
						"minLength": 1
					},
					"summary": {
						"type": "string",
						"minLength": 1
					},
					"changes": {
						"type": "array",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"id",
								"kind",
								"reason"
							],
							"properties": {
								"id": {
									"type": "string",
									"minLength": 1
								},
								"kind": {
									"type": "string",
									"minLength": 1
								},
								"reason": {
									"type": "string"
								},
								"asvs_reconciliation": {
									"type": "array",
									"items": {
										"type": "object"
									},
									"minItems": 0
								},
								"old_status": {
									"type": "string",
									"minLength": 1
								},
								"new_status": {
									"type": "string",
									"minLength": 1
								},
								"why_sufficient": {
									"type": "string",
									"minLength": 1
								},
								"remains_unproven": {
									"type": "string",
									"minLength": 1
								},
								"evidence_added": {
									"type": "array",
									"items": {
										"type": "string",
										"minLength": 1
									},
									"minItems": 1
								},
								"minimum_level": {
									"enum": [
										"E1",
										"E2",
										"E3",
										"E4",
										"E5"
									]
								},
								"before": {
									"type": "object"
								},
								"after": {
									"type": "object"
								},
								"rationale": {
									"type": "string",
									"minLength": 40
								},
								"why_not_weakening": {
									"type": "string",
									"minLength": 40
								},
								"finding": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"control",
										"property",
										"status_before",
										"status_after",
										"root_cause",
										"code_change",
										"before_behavior",
										"after_behavior",
										"regression_tests",
										"mutation_ids",
										"mutation_result",
										"call_sites_proven",
										"remaining_assumptions"
									],
									"properties": {
										"control": {
											"type": "string",
											"pattern": "^CR-[A-Z]+-[0-9]{3}$"
										},
										"property": {
											"type": "string",
											"pattern": "^P[0-9]+$"
										},
										"status_before": {
											"enum": [
												"OPEN",
												"FIXED"
											]
										},
										"status_after": {
											"enum": [
												"OPEN",
												"FIXED"
											]
										},
										"root_cause": {
											"type": "string",
											"minLength": 20
										},
										"code_change": {
											"type": "string",
											"minLength": 20
										},
										"before_behavior": {
											"type": "string",
											"minLength": 20
										},
										"after_behavior": {
											"type": "string",
											"minLength": 20
										},
										"regression_tests": {
											"type": "array",
											"items": {
												"type": "string",
												"minLength": 1
											},
											"minItems": 1
										},
										"mutation_ids": {
											"type": "array",
											"items": {
												"type": "string",
												"minLength": 1
											},
											"minItems": 1
										},
										"mutation_result": {
											"enum": [
												"KILLED"
											]
										},
										"call_sites_proven": {
											"type": "array",
											"items": {
												"type": "string",
												"minLength": 1
											},
											"minItems": 1
										},
										"remaining_assumptions": {
											"type": "string",
											"minLength": 20
										},
										"affected_population": {
											"type": "string",
											"minLength": 20
										},
										"order_before": {
											"type": "object",
											"additionalProperties": {
												"type": "string",
												"minLength": 10
											}
										},
										"order_after": {
											"type": "object",
											"additionalProperties": {
												"type": "string",
												"minLength": 10
											}
										},
										"application_files_changed": {
											"type": "array",
											"items": {
												"type": "string",
												"minLength": 1
											},
											"minItems": 1
										},
										"affected_endpoints": {
											"type": "array",
											"items": {
												"type": "string",
												"minLength": 1
											},
											"minItems": 1
										},
										"cache_dependency": {
											"type": "string",
											"minLength": 20
										},
										"global_budget_used": {
											"type": "string",
											"minLength": 20
										}
									}
								}
							}
						},
						"minItems": 0
					}
				}
			},
			"minItems": 1
		}
	}
}
