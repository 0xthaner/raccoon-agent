# Fremder Code aus Abhaengigkeiten darf beim Installieren nicht ausgefuehrt werden.
# postinstall & Co. laufen VOR jedem Test und vor jedem Blick in den Quelltext.
#
# Steht hier und nicht nur im installCommand, weil Vercel die Serverless-Funktionen
# in einem ZWEITEN Lauf installiert, der das installCommand nicht beachtet. Eine
# .npmrc im Projekt gilt fuer beide.
ignore-scripts=true

# Nur die offizielle Registry (Dependency Confusion).
registry=https://registry.npmjs.org/
