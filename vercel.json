{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/alerts", "schedule": "0 8 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.web3modal.org; font-src 'self' data:; connect-src 'self' https://api.web3modal.org https://rpc.walletconnect.org https://pulse.walletconnect.org https://verify.walletconnect.org wss://relay.walletconnect.org; frame-src https://verify.walletconnect.org; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp" },
        { "key": "Reporting-Endpoints", "value": "csp=\"/api/csp-report\"" }
      ]
    }
  ],
  "redirects": [
    { "source": "/((?!api/).*)", "has": [{ "type": "host", "value": "agent.coverraccoon.com" }], "destination": "https://coverraccoon.com/$1", "permanent": false },
    { "source": "/cover", "destination": "https://analysen.coverraccoon.com/cover", "permanent": false },
    { "source": "/cover/:path*", "destination": "https://analysen.coverraccoon.com/cover/:path*", "permanent": false },
    { "source": "/de", "destination": "https://analysen.coverraccoon.com/de", "permanent": false },
    { "source": "/de/:path*", "destination": "https://analysen.coverraccoon.com/de/:path*", "permanent": false },
    { "source": "/agb", "destination": "https://analysen.coverraccoon.com/agb", "permanent": false },
    { "source": "/brokers", "destination": "https://analysen.coverraccoon.com/brokers", "permanent": false },
    { "source": "/brokers/:path*", "destination": "https://analysen.coverraccoon.com/brokers/:path*", "permanent": false },
    { "source": "/covered", "destination": "https://analysen.coverraccoon.com/covered", "permanent": false },
    { "source": "/covered/:path*", "destination": "https://analysen.coverraccoon.com/covered/:path*", "permanent": false },
    { "source": "/market", "destination": "https://analysen.coverraccoon.com/market", "permanent": false },
    { "source": "/market/:path*", "destination": "https://analysen.coverraccoon.com/market/:path*", "permanent": false },
    { "source": "/pools", "destination": "https://analysen.coverraccoon.com/pools", "permanent": false },
    { "source": "/pools/:path*", "destination": "https://analysen.coverraccoon.com/pools/:path*", "permanent": false },
    { "source": "/internal/:path*", "destination": "https://analysen.coverraccoon.com/internal/:path*", "permanent": false },
    { "source": "/api", "destination": "https://analysen.coverraccoon.com/api", "permanent": false },
    { "source": "/api/agent/:path*", "destination": "https://analysen.coverraccoon.com/api/agent/:path*", "permanent": false },
    { "source": "/api/brokers", "destination": "https://analysen.coverraccoon.com/api/brokers", "permanent": false },
    { "source": "/api/brokers/:path*", "destination": "https://analysen.coverraccoon.com/api/brokers/:path*", "permanent": false },
    { "source": "/api/cover/:path*", "destination": "https://analysen.coverraccoon.com/api/cover/:path*", "permanent": false },
    { "source": "/api/covered-badge/:path*", "destination": "https://analysen.coverraccoon.com/api/covered-badge/:path*", "permanent": false },
    { "source": "/api/internal/:path*", "destination": "https://analysen.coverraccoon.com/api/internal/:path*", "permanent": false },
    { "source": "/api/market/:path*", "destination": "https://analysen.coverraccoon.com/api/market/:path*", "permanent": false },
    { "source": "/api/search", "destination": "https://analysen.coverraccoon.com/api/search", "permanent": false },
    { "source": "/api/search/:path*", "destination": "https://analysen.coverraccoon.com/api/search/:path*", "permanent": false },
    { "source": "/sitemap.xml", "destination": "https://analysen.coverraccoon.com/sitemap.xml", "permanent": false },
    { "source": "/openapi.json", "destination": "https://analysen.coverraccoon.com/openapi.json", "permanent": false },
    { "source": "/.well-known/agent.json", "destination": "https://analysen.coverraccoon.com/.well-known/agent.json", "permanent": false },
    { "source": "/logo.svg", "destination": "https://analysen.coverraccoon.com/logo.svg", "permanent": false },
    { "source": "/icon.svg", "destination": "https://analysen.coverraccoon.com/icon.svg", "permanent": false }
  ],
  "rewrites": [
    { "source": "/link", "destination": "/index.html" },
    { "source": "/anleitung", "destination": "/guide.html" },
    { "source": "/guide", "destination": "/guide.html" },
    { "source": "/datenschutz", "destination": "/datenschutz.html" },
    { "source": "/privacy", "destination": "/datenschutz.html" },
    { "source": "/impressum", "destination": "/impressum.html" },
    { "source": "/imprint", "destination": "/impressum.html" }
  ]
}
